PORT=3000

# Chat: OpenCode Zen (no SDK). Free models need no key.
LLM_PROVIDER=opencode
OPENCODE_MODEL=hy3-free
OPENCODE_BASE_URL=https://opencode.ai/zen/v1/chat/completions
OPENCODE_API_KEY=
OPENAI_TIMEOUT_MS=15000

# Local MiniLM embeddings via onnxruntime-web (no sharp / no API key).
# First run downloads vocab + quantized ONNX into data/models/
